# Which AI provider to use: "gemini" | "openai" | "huggingface" | "mock"
# Defaults to "gemini". Falls back to "mock" automatically if the selected
# provider's required key(s) are missing, so the app always boots.
AI_PROVIDER=gemini

# --- Gemini (default provider) ---
# Get a key at https://aistudio.google.com/apikey
# Note: the free tier covers text/vision analysis, but image generation
# models require a billing account linked to the Google Cloud project.
# Google renames model IDs often — if you get a 404, see the README
# "Troubleshooting: Gemini model 404s" section.
GEMINI_API_KEY=
# Optional overrides (defaults shown):
# GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- OpenAI (alternate provider) ---
# Get a key at https://platform.openai.com/api-keys
# Note: requires paid credits — no meaningful free tier for image generation.
OPENAI_API_KEY=
# Optional overrides (defaults shown):
# OPENAI_ANALYSIS_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Hugging Face (experimental, free image generation) ---
# Analysis still runs on Gemini's free tier (GEMINI_API_KEY required above);
# only image generation uses a free Hugging Face-hosted model. Lower quality
# than Gemini/OpenAI, and the shared free inference API can be slow or
# briefly unavailable while a model "warms up". No card required — get a
# token at https://huggingface.co/settings/tokens (read access is enough).
HF_API_TOKEN=
